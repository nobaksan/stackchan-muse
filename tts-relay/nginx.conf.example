# Put this in /etc/nginx/conf.d/stackchan-tts-ratelimit.conf (http context):
#   limit_req_zone $binary_remote_addr zone=stackchan_tts_rl:1m rate=30r/m;
#   limit_conn_zone $binary_remote_addr zone=stackchan_tts_conn:1m;
#
# Then this server block. Get the certificate first with certbot (webroot).
server {
    listen 443 ssl http2;
    server_name tts.example.com;

    ssl_certificate     /etc/letsencrypt/live/tts.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tts.example.com/privkey.pem;

    client_max_body_size 16k;
    limit_req  zone=stackchan_tts_rl burst=10 nodelay;
    limit_conn stackchan_tts_conn 4;
    proxy_read_timeout 60s;

    location = /health { proxy_pass http://127.0.0.1:3710; }

    # The app checks X-TTS-Key. Stream the MP3 as it's made: no buffering.
    location = /tts {
        proxy_pass http://127.0.0.1:3710;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / { return 404; }
}
