+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include "cJSON.h"
+#include "noise_control.h"
+
+// StackChan's two-axis neck on an M5Stack CoreS3: two Feetech SCS servos on
+// UART1 (TX GPIO 6, RX GPIO 7, 1 Mbps), powered through pin 0 of the PY32 IO
+// expander at 0x6F on the internal I2C bus. Constants follow M5Stack's
+// StackChan-BSP (servo_init() in M5StackChan.cpp).
+//
+// Handles head.move, head.gesture and head.get. Each runs in its own task and
+// answers with noise_ctrl_send_command_result(), so it returns {"_async": true}
+// or a command error. Returns NULL when the command isn't a head command.
+cJSON *stackchan_head_command(const char *command, cJSON *params,
+                              const char *request_id,
+                              noise_ctrl_session_generation_t session_generation);
