+#if CONFIG_MUSE_HTTP_TTS
+static void tts_data(const uint8_t *data, size_t len);
+
+/*
+ * One long-lived worker owns the HTTP client, so the TLS connection (over 4 s
+ * on this chip) is opened once and kept alive: http_tts_warm() opens it while
+ * Muse is still thinking, and the reply's speech then reuses it.
+ */
+enum http_tts_job_t : uint8_t { HJ_WARM, HJ_SPEAK };
+struct http_tts_req_t {
+    http_tts_job_t kind;
+    char *body;
+};
+static QueueHandle_t s_http_tts_q;
+
+static void http_tts_drain(esp_http_client_handle_t c)
+{
+    static char sink[512];
+    while (esp_http_client_read(c, sink, sizeof(sink)) > 0) {
+    }
+}
+
+static bool http_tts_speak(esp_http_client_handle_t c, const char *body)
+{
+    static uint8_t buf[2048];
+    int len = (int)strlen(body);
+    int64_t t0 = now_us();
+    esp_http_client_set_method(c, HTTP_METHOD_POST);
+    for (int attempt = 0; attempt < 2; attempt++) {
+        /* A kept-alive connection the server has since closed fails here; reconnect once. */
+        ESP_LOGI(TAG, "tts relay: attempt %d, state %d, socket %d", attempt,
+                 (int)esp_http_client_get_state(c), esp_http_client_get_socket(c));
+        esp_err_t oerr = esp_http_client_open(c, len);
+        int wrote = oerr == ESP_OK ? esp_http_client_write(c, body, len) : -1;
+        int64_t hl = wrote == len ? esp_http_client_fetch_headers(c) : -1;
+        if (hl >= 0) {
+            break;
+        }
+        ESP_LOGW(TAG, "tts relay: attempt %d failed: open %s, wrote %d/%d, headers %lld", attempt,
+                 esp_err_to_name(oerr), wrote, len, (long long)hl);
+        esp_http_client_close(c);
+        if (attempt) {
+            ESP_LOGW(TAG, "tts relay: request failed");
+            return false;
+        }
+    }
+    int status = esp_http_client_get_status_code(c);
+    ESP_LOGI(TAG, "tts relay: headers after %lld ms", (long long)((now_us() - t0) / 1000));
+    if (status != 200) {
+        ESP_LOGW(TAG, "tts relay: HTTP %d", status);
+        http_tts_drain(c);
+        return false;
+    }
+    bool ok = false;
+    size_t total = 0;
+    for (;;) {
+        int n = esp_http_client_read(c, reinterpret_cast<char *>(buf), sizeof(buf));
+        if (n < 0 || s_http_tts_abort) {
+            break;
+        }
+        if (n == 0) {
+            ok = esp_http_client_is_complete_data_received(c);
+            break;
+        }
+        if (!total) {
+            ESP_LOGI(TAG, "tts relay: first %d bytes after %lld ms", n, (long long)((now_us() - t0) / 1000));
+        }
+        size_t off = 0;
+        while (off < (size_t)n && !s_http_tts_abort) {
+            off += xStreamBufferSend(s_http_tts_sb, buf + off, n - off, pdMS_TO_TICKS(100));
+        }
+        total += n;
+    }
+    ESP_LOGI(TAG, "tts relay: %u bytes in %lld ms%s", (unsigned)total,
+             (long long)((now_us() - t0) / 1000), ok ? "" : " (incomplete)");
+    if (!ok) {
+        esp_http_client_close(c);   /* don't reuse a half-read response */
+    }
+    return ok;
+}
+
+static void http_tts_worker(void *)
+{
+    esp_http_client_config_t cfg = {};
+    cfg.url = CONFIG_MUSE_HTTP_TTS_URL;
+    cfg.timeout_ms = 15000;
+    cfg.buffer_size = 2048;
+    cfg.crt_bundle_attach = esp_crt_bundle_attach;
+    esp_http_client_handle_t c = esp_http_client_init(&cfg);
+    if (c) {
+        esp_http_client_set_header(c, "Content-Type", "application/json");
+        esp_http_client_set_header(c, "X-TTS-Key", CONFIG_MUSE_HTTP_TTS_KEY);
+    }
+    for (;;) {
+        http_tts_req_t req;
+        xQueueReceive(s_http_tts_q, &req, portMAX_DELAY);
+        if (req.kind == HJ_WARM) {
+            if (!c) {
+                continue;
+            }
+            /* Any small request will do; GET /tts is refused at once and leaves the connection up. */
+            int64_t t0 = now_us();
+            esp_http_client_set_method(c, HTTP_METHOD_GET);
+            if (esp_http_client_open(c, 0) == ESP_OK && esp_http_client_fetch_headers(c) >= 0) {
+                http_tts_drain(c);
+                ESP_LOGI(TAG, "tts relay: warmed in %lld ms (state %d, socket %d, keep-alive %d)",
+                         (long long)((now_us() - t0) / 1000), (int)esp_http_client_get_state(c),
+                         esp_http_client_get_socket(c), (int)esp_http_client_is_persistent_connection(c));
+            } else {
+                esp_http_client_close(c);
+            }
+            continue;
+        }
+        bool ok = c && http_tts_speak(c, req.body);
+        free(req.body);
+        s_http_tts_state = ok ? HT_DONE : HT_FAILED;
+    }
+}
+
+static bool http_tts_ensure_worker(void)
+{
+    if (s_http_tts_q) {
+        return true;
+    }
+    s_http_tts_sb = xStreamBufferCreateWithCaps(HTTP_TTS_SB, 1, MALLOC_CAP_SPIRAM);
+    s_http_tts_q = xQueueCreate(2, sizeof(http_tts_req_t));
+    if (!s_http_tts_sb || !s_http_tts_q ||
+        xTaskCreatePinnedToCoreWithCaps(http_tts_worker, "http_tts", 12 * 1024, nullptr, 4, nullptr, 1,
+                                        MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        ESP_LOGE(TAG, "tts relay: worker start failed");
+        s_http_tts_q = nullptr;
+        return false;
+    }
+    return true;
+}
+
+/* Opens the relay's connection ahead of the reply. */
+static void http_tts_warm(void)
+{
+    if (s_http_tts_state.load() == HT_RUNNING || !http_tts_ensure_worker()) {
+        return;
+    }
+    http_tts_req_t req = { HJ_WARM, nullptr };
+    xQueueSend(s_http_tts_q, &req, 0);
+}
+
+/* Starts fetching message i's speech. False if it couldn't start. */
+static bool http_tts_start(int i)
+{
+    if (!s_turn.texts || !http_tts_ensure_worker()) {
+        return false;
+    }
+    xStreamBufferReset(s_http_tts_sb);
+    cJSON *o = cJSON_CreateObject();
+    cJSON_AddStringToObject(o, "text", s_turn.texts + i * TEXT_MAX);
+    char *body = cJSON_PrintUnformatted(o);
+    cJSON_Delete(o);
+    if (!body) {
+        return false;
+    }
+    s_http_tts_abort = false;
+    s_http_tts_msg = i;
+    s_http_tts_state = HT_RUNNING;
+    http_tts_req_t req = { HJ_SPEAK, body };
+    if (xQueueSend(s_http_tts_q, &req, 0) != pdPASS) {
+        free(body);
+        s_http_tts_state = HT_IDLE;
+        s_http_tts_msg = -1;
+        return false;
+    }
+    return true;
+}
+
+/* Moves the relay's MP3 into the turn's buffer; ends the message's audio when it's all in. */
+static void http_tts_pump(void)
+{
+    if (s_turn.tts_msg < 0 || s_turn.silent || s_turn.mp3_ended || s_http_tts_msg != s_turn.tts_msg) {
+        return;
+    }
+    int st = s_http_tts_state.load();
+    static uint8_t tmp[2048];
+    while (MP3_BUF - s_turn.mp3_len > 0) {
+        size_t want = MP3_BUF - s_turn.mp3_len < sizeof(tmp) ? MP3_BUF - s_turn.mp3_len : sizeof(tmp);
+        size_t n = xStreamBufferReceive(s_http_tts_sb, tmp, want, 0);
+        if (!n) {
+            break;
+        }
+        tts_data(tmp, n);
+    }
+    if (st == HT_RUNNING || !xStreamBufferIsEmpty(s_http_tts_sb)) {
+        return;
+    }
+    s_http_tts_msg = -1;
+    s_http_tts_state = HT_IDLE;
+    if (st == HT_DONE) {
+        s_turn.mp3_ended = true;   /* decode() drains the rest, then finishes */
+        return;
+    }
+    /* The relay failed: show the message at reading pace instead. */
+    msg_t &m = s_turn.msgs[s_turn.tts_msg];
+    ESP_LOGW(TAG, "tts relay failed; showing message %s silently", m.id);
+    m.pcm_start = s_turn.pcm_out;
+    m.pcm_frames = (uint32_t)(m.len * MIC_RATE / TEXT_CHARS_PER_S);
+    s_turn.silent = true;
+}
+#endif
